{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/board.mjs:*)",
      "Bash(bash scripts/dod.sh)",
      "Bash(bash scripts/hooks/*)",
      "Bash(npx -y lavish-axi:*)",
      "Bash(lavish-axi:*)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "dev",
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/dod-gate.sh" }
        ]
      }
    ]
  }
}
