{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event.schema.json",
  "title": "Event du board (trace terse)",
  "type": "object",
  "required": ["ts", "type", "actor"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "enum": ["delegate", "report", "move", "gate", "peer_message", "escalation", "human_feedback"]
    },
    "actor": { "type": "string" },
    "target": { "type": "string" },
    "us": { "type": "string" },
    "note": { "type": "string", "description": "court, optionnel" },
    "payload": { "type": "object", "description": "contrat associé si utile" }
  }
}
